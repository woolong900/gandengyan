[Unit]
Description=潜江棋牌游戏正式服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qjqp
Group=qjqp
WorkingDirectory=/opt/qjqp
Environment=HOST=127.0.0.1
Environment=PORT=8899
Environment=QJQP_DB=/var/lib/qjqp/state.sqlite
Environment=QJQP_STATE=/var/lib/qjqp/state.json
Environment=QJQP_PUBLIC_BASE_URL=https://gandengyan.top
Environment=QJQP_LOAD_DEV_VARS=0
Environment=QJQP_FILLBOTS=1
ExecStart=/usr/bin/node /opt/qjqp/server/index.js
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qjqp

[Install]
WantedBy=multi-user.target
